# Variables de la API (archivo backend/.env, no versionado).
SECRET_KEY=cambie_esta_clave_larga_y_aleatoria
# Para ejecutar la API fuera de Docker (host localhost). La contraseña debe ser la misma
# POSTGRES_PASSWORD del .env de la raíz. Dentro de docker compose esta variable se reemplaza.
DATABASE_URL=postgresql+psycopg://pensar_user:cambie_esta_contrasena@localhost:5432/pensar_db
